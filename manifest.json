{
  "manifest_version": 3,
  "name": "RSS Feed Warrior",
  "version": "2.0.0",
  "description": "Monitor RSS and Atom feeds for new content. Get instant notifications with one-click article access.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon128.png",
    "default_title": "RSS Feed Warrior"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
